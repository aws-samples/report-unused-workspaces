{
  "name": "report-unused-workspaces",
  "version": "1.0.0",
  "description": "CDK app that detects and reports unused Amazon WorkSpaces.",
  "private": true,
  "bin": {
    "app": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/client-sns": "^3.658.1",
    "@aws-sdk/client-workspaces": "^3.658.1",
    "@eslint/js": "^9.39.4",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "aws-cdk": "2.1118.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^2.28.195",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.11.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.176.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
