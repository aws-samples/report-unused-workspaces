{
  "name": "report-unused-workspaces",
  "version": "1.1.0",
  "description": "CDK app that detects and reports unused Amazon WorkSpaces.",
  "private": true,
  "bin": {
    "app": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
